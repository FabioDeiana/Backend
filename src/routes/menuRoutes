const express = require("express");
const router = express.Router({ mergeParams: true });
const { getMenuItems, createMenuItem, updateMenuItem, deleteMenuItem } = require("../controllers/menuController");
const { protect, authorize } = require("../middleware/auth");

router.get("/", getMenuItems);
router.post("/", protect, authorize("admin", "owner"), createMenuItem);
router.put("/:id", protect, authorize("admin", "owner"), updateMenuItem);
router.delete("/:id", protect, authorize("admin", "owner"), deleteMenuItem);

module.exports = router;